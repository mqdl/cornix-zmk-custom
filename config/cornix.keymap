#define ZMK_POINTING_DEFAULT_SCRL_VAL 50
#define JP_DQUOTE       AT                // "
#define JP_AMPERSAND    CARET             // &
#define JP_QUOTE        AMPERSAND         // '
#define JP_EQUAL        UNDER             // =
#define JP_CARET        EQUAL             // ^
#define JP_YEN          0x89              // ¥
#define JP_PLUS         COLON             // +
#define JP_TILDE        PLUS              // ~
#define JP_PIPE         LS(0x89)          // |
#define JP_AT           LEFT_BRACKET      // @
#define JP_COLON        SINGLE_QUOTE      // :
#define JP_ASTERISK     DOUBLE_QUOTES     // *
#define JP_BACKQUOTE    LEFT_BRACE        // `
#define JP_UNDERSCORE   LS(0x87)          // _
#define JP_LBRACKET     RIGHT_BRACKET     // [
#define JP_RBRACKET     BACKSLASH         // ]
#define JP_LPAREN       ASTERISK          // (
#define JP_RPAREN       LEFT_PARENTHESIS  // )
#define JP_LBRACE       RIGHT_BRACE       // {
#define JP_RBRACE       PIPE              // }
#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_BSLH         INTERNATIONAL_1   // ろ（右下の \ と _ のキー）

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };

        minus {
            bindings = <&kp MINUS>;
            key-positions = <8 9>;
        };

        alt_f4 {
            bindings = <&kp LA(F4)>;
            key-positions = <3 4 5>;
        };

        equal {
            bindings = <&kp JP_EQUAL>;
            key-positions = <9 10>;
        };

        tidle {
            bindings = <&kp JP_TILDE>;
            key-positions = <7 8>;
        };

        pipe {
            bindings = <&kp JP_PIPE>;
            key-positions = <18 32>;
        };

        underscore {
            bindings = <&kp JP_UNDERSCORE>;
            key-positions = <37 36>;
        };

        del {
            bindings = <&kp DELETE>;
            key-positions = <10 11>;
        };

        question {
            bindings = <&kp QUESTION>;
            key-positions = <6 7>;
        };

        pointerref {
            bindings = <&pointer_macro>;
            key-positions = <18 19>;
        };

        win {
            bindings = <&kp LEFT_GUI>;
            key-positions = <39 40>;
        };

        space {
            bindings = <&kp SPACE>;
            key-positions = <44 43>;
        };
    };

    macros {
        pointer_macro: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp KP_MINUS &kp GT>;
            label = "NEW_MACRO";
        };
    };

    behaviors {
        scrl_enc: scrl_enc {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

            tap-ms = <50>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&lt 5 ESC         &kp Q  &kp W         &kp E       &kp R        &kp T                        &kp Y  &kp U        &kp I       &kp O     &kp P         &kp BACKSPACE
&kp TAB           &kp A  &kp S         &kp D       &kp F        &kp G                        &kp H  &kp J        &kp K       &kp L     &kp SEMI      &kp ENTER
&kp LEFT_SHIFT    &kp Z  &kp X         &kp C       &kp V        &kp B  &kp C_MUTE  &kp INT2  &kp N  &kp M        &kp COMMA   &kp DOT   &kp UP_ARROW  &kp SLASH
&kp LEFT_CONTROL  &mo 4  &kp LEFT_ALT  &lt 3 INT5  &lt 1 SPACE  &mo 2                        &mo 2  &lt 1 SPACE  &lt 3 INT4  &kp LEFT  &kp DOWN      &kp RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scrl_enc>;
        };

        Num_layer {
            display-name = "num";
            bindings = <
&trans  &kp N1  &kp N2  &kp N3  &kp N4  &kp N5                  &kp N6  &kp N7    &kp N8    &kp N9     &kp N0  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &kp LEFT  &kp UP    &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp LEFT  &kp DOWN  &kp RIGHT  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans    &trans    &trans     &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scrl_enc>;
        };

        Symbol_layer {
            display-name = "Symbols";
            bindings = <
&trans  &kp EXCLAMATION  &kp JP_DQUOTE  &kp HASH   &kp DOLLAR   &kp PERCENT                   &kp JP_AMPERSAND  &kp JP_QUOTE  &kp JP_LPAREN    &kp JP_RPAREN    &kp MINUS         &kp JP_EQUAL
&trans  &trans           &trans         &kp MINUS  &kp LS(DOT)  &kp DOT                       &kp JP_ASTERISK   &kp JP_TILDE  &kp JP_LBRACKET  &kp JP_RBRACKET  &kp SEMI          &kp JP_COLON
&trans  &trans           &trans         &trans     &trans       &kp JP_COLON  &trans  &trans  &kp JP_PLUS       &kp JP_CARET  &kp JP_LBRACE    &kp JP_RBRACE    &kp JP_YEN        &kp JP_BSLH
&trans  &trans           &trans         &trans     &trans       &trans                        &trans            &trans        &trans           &kp JP_AT        &kp JP_BACKQUOTE  &kp JP_UNDERSCORE
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scrl_enc>;
        };

        Function_layer {
            display-name = "Func";
            bindings = <
&trans  &kp F1      &kp F2      &kp F3      &kp F4      &kp F5                      &kp F6      &kp F7      &kp F8      &kp F9      &kp F10      &kp F11
&trans  &kp LS(F1)  &kp LS(F2)  &kp LS(F3)  &kp LS(F4)  &kp LS(F5)                  &kp LS(F6)  &kp LS(F7)  &kp LS(F8)  &kp LS(F9)  &kp LS(F10)  &kp F12
&trans  &kp LC(F1)  &kp LC(F2)  &kp LC(F3)  &kp LC(F4)  &kp LC(F5)  &trans  &trans  &kp LC(F6)  &kp LC(F7)  &kp LC(F8)  &kp LC(F9)  &kp LC(F10)  &trans
&trans  &trans      &trans      &trans      &trans      &trans                      &trans      &trans      &trans      &trans      &trans       &trans
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scrl_enc>;
        };

        TenKey_layer {
            display-name = "TenKey";
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &kp KP_DOT       &kp KP_NUMBER_0  &kp ENTER
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scrl_enc>;

            label = "TenKey";
        };

        BT_layer {
            display-name = "BT";
            bindings = <
&trans          &bt BT_SEL 0   &bt BT_SEL 1   &bt BT_SEL 2   &bt BT_SEL 3   &bt BT_SEL 4                   &trans  &trans  &trans  &trans          &trans          &trans
&bt BT_CLR      &bt BT_DISC 0  &bt BT_DISC 1  &bt BT_DISC 2  &bt BT_DISC 3  &bt BT_DISC 4                  &trans  &trans  &trans  &trans          &mkp MCLK       &trans
&bt BT_CLR_ALL  &trans         &trans         &trans         &trans         &trans         &trans  &trans  &trans  &trans  &trans  &mkp LCLK       &mmv MOVE_UP    &mkp RCLK
&trans          &trans         &trans         &trans         &trans         &trans                         &trans  &trans  &trans  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT
            >;

            sensor-bindings = <&inc_dec_kp C_VOL_UP C_VOL_DN>, <&scrl_enc>;
        };
    };
};
